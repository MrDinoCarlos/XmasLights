+  public boolean syncExternalDeployment(UUID id, Set<Integer> managedIds) {
+    if (!Bukkit.isPrimaryThread()) throw new IllegalStateException("Server thread required");
+    Deployment deployment = active.get(id);
+    if (deployment == null || busyDecorations.contains(deployment.decorationId())) return false;
+    reconcileExternalEntities(deployment, managedIds);
+    try { persistRequired(deployment, "DEPLOY", ""); }
+    catch (IOException failure) { throw new IllegalStateException("Could not persist regenerated entities", failure); }
+    return true;
+  }
+  public String externalDeploymentState(UUID id) {
+    if (active.containsKey(id) || recovery.containsKey(id)) return "LIVE";
+    return journal.retained(id) ? "RETAINED" : "REMOVED";
+  }
+
+  private void reconcileExternalEntities(Deployment deployment, Set<Integer> managedIds) {
+    World world = Bukkit.getWorld(deployment.target().worldId());
+    if (world == null) throw new IllegalStateException("world-missing:" + deployment.target().worldName());
+    Map<Integer, UUID> entities = new LinkedHashMap<>(deployment.spawnedEntities());
+    managedIds.forEach(entities::remove);
+    Set<BlockKey> locations = new LinkedHashSet<>(deployment.entityLocations());
+    int next = -1;
+    for (Entity entity : world.getEntities()) {
+      var data = entity.getPersistentDataContainer();
+      if (!deployment.id().toString().equals(data.get(DecoSwapPlugin.DEPLOYMENT_ID_KEY, PersistentDataType.STRING))
+          || !XmasLightsIntegration.managed(entity)) continue;
+      Integer local = data.get(DecoSwapPlugin.LOCAL_ENTITY_ID_KEY, PersistentDataType.INTEGER);
+      if (local == null || entities.containsKey(local) && !entities.get(local).equals(entity.getUniqueId())) {
+        while (entities.containsKey(next) || managedIds.contains(next)) next--;
+        local = next--;
+        data.set(DecoSwapPlugin.LOCAL_ENTITY_ID_KEY, PersistentDataType.INTEGER, local);
+      }
+      entities.put(local, entity.getUniqueId()); locations.add(BlockKey.of(entity.getLocation()));
+    }
+    deployment.replaceSpawned(entities); deployment.replaceEntityLocations(locations);
   }
 
