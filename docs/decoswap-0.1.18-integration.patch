+package es.mrdino.decoswap.compat;
+
+import es.mrdino.decoswap.decoration.*;
+import es.mrdino.decoswap.deployment.Deployment;
+import es.mrdino.decoswap.selection.PlayerSelection;
+import es.mrdino.decoswap.util.Rotation;
+import java.lang.reflect.InvocationTargetException;
+import java.nio.charset.StandardCharsets;
+import java.util.*;
+import org.bukkit.*;
+import org.bukkit.block.Block;
+import org.bukkit.entity.*;
+import org.bukkit.plugin.Plugin;
+
+/** Optional XmasLights protocol 1. Neither plugin links the other's implementation classes. */
+public final class XmasLightsIntegration {
+  public static final String STATE = "_xmaslights.state", CONTENT = "_xmaslights.content", ROLE = "_xmaslights.role";
+  private static final NamespacedKey STRING = Objects.requireNonNull(NamespacedKey.fromString("xmaslights:string"));
+  private XmasLightsIntegration() {}
+
+  private static Object call(boolean required, String method, Class<?>[] signature, Object... args) {
+    Plugin plugin = Bukkit.getPluginManager().getPlugin("XmasLights");
+    if (plugin == null || !plugin.isEnabled()) {
+      if (required) throw new IllegalStateException("xmaslights-required");
+      return null;
+    }
+    try {
+      Object api = plugin.getClass().getMethod("decoSwap").invoke(plugin);
+      if (api == null || !Integer.valueOf(1).equals(api.getClass().getMethod("protocolVersion").invoke(api)))
+        throw new IllegalStateException("xmaslights-required");
+      return api.getClass().getMethod(method, signature).invoke(api, args);
+    } catch (InvocationTargetException failure) {
+      Throwable cause = failure.getCause();
+      if (cause instanceof RuntimeException runtime) throw runtime;
+      throw new IllegalStateException(cause);
+    } catch (NoSuchMethodException failure) {
+      if (!required) return null;
+      throw new IllegalStateException("xmaslights-required", failure);
+    } catch (ReflectiveOperationException failure) {
+      throw new IllegalStateException("xmaslights-required", failure);
+    }
+  }
+  public static boolean managed(Entity entity) { return entity != null && entity.getPersistentDataContainer().has(STRING); }
+  public static void expand(PlayerSelection selection, Player player, int limit) {
+    if (selection.entities().stream().map(Bukkit::getEntity).noneMatch(XmasLightsIntegration::managed)) return;
+    @SuppressWarnings("unchecked") Set<UUID> expanded = (Set<UUID>) call(true, "expandSelection", new Class<?>[]{Collection.class, Player.class}, selection.entities(), player);
+    if (expanded.size() > limit) throw new IllegalStateException("selection-limit");
+    if (!expanded.equals(selection.entities())) selection.replace(List.copyOf(selection.blocks()), expanded, selection.anchor());
+  }
+  public static void capture(Entity entity, Anchor anchor, Map<String, String> properties, Map<String, byte[]> items) {
+    if (!managed(entity)) return;
+    @SuppressWarnings("unchecked") Map<String, String> state = (Map<String, String>) call(true, "capture", new Class<?>[]{Entity.class, Location.class}, entity, location(anchor));
+    properties.put(CONTENT, state.get("content"));
+    if (state.get("role") != null) properties.put(ROLE, state.get("role"));
+    items.put(STATE, state.get("state").getBytes(StandardCharsets.UTF_8));
+  }
+  public static void validate(Decoration decoration, Anchor target, Rotation rotation, UUID actor) {
+    List<byte[]> states = decoration.entities().stream().map(e -> e.items().get(STATE)).filter(Objects::nonNull).toList();
+    if (!states.isEmpty()) call(true, "validateDeployment", new Class<?>[]{List.class, Location.class, int.class, UUID.class}, states, location(target), rotation.degrees(), actor);
+    for (EntityRecord record : decoration.entities()) if (!record.items().containsKey(STATE) && record.pdc().length > 0) {
+      var context = Bukkit.getItemFactory().getItemMeta(Material.PAPER).getPersistentDataContainer().getAdapterContext();
+      var data = context.newPersistentDataContainer();
+      try { data.readFromBytes(record.pdc(), true); }
+      catch (java.io.IOException failure) { throw new IllegalStateException("xmaslights-invalid", failure); }
+      if (data.has(STRING)) throw new IllegalStateException("xmaslights-resave");
+    }
+  }
+  public static void adopt(Entity entity, EntityRecord record, Anchor target, Rotation rotation, UUID decoration, UUID deployment, UUID actor) {
+    byte[] state = record.items().get(STATE);
+    if (state != null) call(true, "adopt", new Class<?>[]{Entity.class, byte[].class, Location.class, int.class, UUID.class, UUID.class, UUID.class, int.class},
+        entity, state, location(target), rotation.degrees(), decoration, deployment, actor, record.localId());
+  }
+  public static void beforeSpawn(EntityRecord record, Anchor target, Rotation rotation, UUID decoration, UUID deployment, UUID actor) {
+    byte[] state = record.items().get(STATE);
+    if (state != null) call(true, "prepare", new Class<?>[]{byte[].class, Location.class, int.class, UUID.class, UUID.class, UUID.class}, state, location(target), rotation.degrees(), decoration, deployment, actor);
+  }
+  public static boolean matches(EntityRecord record, Entity entity, EntityType fallback) {
+    String role = record.properties().get(ROLE);
+    if (role != null) return managed(entity) && role.equals(entity.getPersistentDataContainer().get(
+        Objects.requireNonNull(NamespacedKey.fromString("xmaslights:part")), org.bukkit.persistence.PersistentDataType.STRING));
+    return fallback == null || entity.getType() == fallback;
+  }
+  public static void finish(Deployment deployment, boolean required) {
+    call(required, "finishDeployment", new Class<?>[]{UUID.class}, deployment.id());
+  }
+  public static void release(UUID deployment) { call(false, "releaseDeployment", new Class<?>[]{UUID.class}, deployment); }
+  public static void detach(UUID deployment) { call(false, "detachDeployment", new Class<?>[]{UUID.class}, deployment); }
+  public static void remove(Collection<UUID> entities, Player player) {
+    if (entities.stream().map(Bukkit::getEntity).anyMatch(XmasLightsIntegration::managed))
+      call(true, "removeSelected", new Class<?>[]{Collection.class, Player.class}, entities, player);
+  }
+  public static String originalBlock(Block block) {
+    if (block.getType() != Material.LIGHT) return null;
+    return (String) call(false, "originalBlock", new Class<?>[]{Block.class}, block);
+  }
+  private static Location location(Anchor anchor) { return new Location(Bukkit.getWorld(anchor.worldId()), anchor.x(), anchor.y(), anchor.z(), anchor.yaw(), anchor.pitch()); }
+}
