+    /** Extend the existing hybrid shader; preserve every TRP beam and native v5 path. */
+    private static void activateStableStrobeSources(Map<String, byte[]> entries) {
+        for (String stage : List.of("vertex", "fragment", "common", "packet"))
+            if (!entries.containsKey("assets/strobelights/shaders/include/stable_slot_" + stage + ".glsl"))
+                throw new IllegalStateException("Missing stable StrobeLights shader extension: " + stage);
+        for (String base : List.of("rendertype_item_entity_translucent_cull", "item")) {
+            for (String extension : List.of("vsh", "fsh")) {
+                String path = "assets/minecraft/shaders/core/" + base + "." + extension;
+                byte[] bytes = entries.get(path);
+                if (bytes == null) continue;
+                String source = new String(bytes, StandardCharsets.UTF_8);
+                if (source.contains("stable_slot_vertex.glsl") || source.contains("stable_slot_fragment.glsl")) continue;
+                boolean vertex = extension.equals("vsh");
+                String include = "#moj_import <strobelights:stable_slot_" + (vertex ? "vertex" : "fragment") + ".glsl>\n";
+                int firstLine = source.indexOf('\n');
+                if (firstLine < 0) throw new IllegalStateException("Invalid shader: " + path);
+                source = source.substring(0, firstLine + 1) + include + source.substring(firstLine + 1);
+                var main = java.util.regex.Pattern.compile("void\\s+main\\s*\\(\\s*\\)\\s*\\{").matcher(source);
+                if (!main.find()) throw new IllegalStateException("Missing shader entry point: " + path);
+                String call = vertex
+                    ? "\n    if (strobeStableSlotVertex(Position, Color, UV0, Sampler0, ProjMat, ModelViewMat)) return;\n"
+                    : "\n    if (strobeStableMarker > 0.5) { strobeStableSlotFragment(fragColor, ProjMat); return; }\n";
+                source = main.replaceFirst(java.util.regex.Matcher.quoteReplacement(main.group() + call));
+                entries.put(path, source.getBytes(StandardCharsets.UTF_8));
+            }
+        }
     }
 
