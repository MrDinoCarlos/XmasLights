+    @Test
+    void stableStrobeExtensionPreservesTheEntireExistingBeamShader() throws Exception {
+        String core = "assets/minecraft/shaders/core/rendertype_item_entity_translucent_cull";
+        String vertex = Files.readString(Path.of("resource-pack/vanilla-reset/shaders/core/rendertype_item_entity_translucent_cull.vsh"));
+        String fragment = Files.readString(Path.of("resource-pack/vanilla-reset/shaders/core/rendertype_item_entity_translucent_cull.fsh"));
+        byte[] base = zip(Map.of(core + ".vsh", vertex, core + ".fsh", fragment));
+        Map<String, String> extra = new LinkedHashMap<>();
+        extra.put("assets/strobelights/strobelights-integration.json", "{\"version\":\"0.10.38\",\"marker_protocol\":\"typed_bitgrid_3x3_v5\",\"stable_source_protocol\":\"slots3x3_depth_v1\"}");
+        for (String stage : List.of("vertex", "fragment", "common", "packet")) extra.put("assets/strobelights/shaders/include/stable_slot_" + stage + ".glsl", "// fixture: " + stage);
+        Map<String, byte[]> result = unzip(ResourcePackMerger.merge(base, List.of(zip(extra))));
+        String updatedVertex = new String(result.get(core + ".vsh"), StandardCharsets.UTF_8);
+        String updatedFragment = new String(result.get(core + ".fsh"), StandardCharsets.UTF_8);
+        assertEquals(vertex.replace("TRP_STROBE_PIPELINE_MODE = 0", "TRP_STROBE_PIPELINE_MODE = 1"),
+            updatedVertex.replace("#moj_import <strobelights:stable_slot_vertex.glsl>\n", "")
+                .replace("\n    if (strobeStableSlotVertex(Position, Color, UV0, Sampler0, ProjMat, ModelViewMat)) return;\n", ""));
+        assertEquals(fragment.replace("TRP_STROBE_PIPELINE_MODE = 0", "TRP_STROBE_PIPELINE_MODE = 1"),
+            updatedFragment.replace("#moj_import <strobelights:stable_slot_fragment.glsl>\n", "")
+                .replace("\n    if (strobeStableMarker > 0.5) { strobeStableSlotFragment(fragColor, ProjMat); return; }\n", ""));
+        extra.remove("assets/strobelights/shaders/include/stable_slot_common.glsl");
+        assertThrows(IllegalStateException.class, () -> ResourcePackMerger.merge(base, List.of(zip(extra))));
+    }
